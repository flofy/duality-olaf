{
  "$schema": "./node_modules/knip/schema.json",
  // `include` makes a type *reported*; the exit code depends on `rules`.
  // `cycles` is not part of knip's defaults, so it must be listed here to be
  // detected — it replaces the external `madge --circular` tool.
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "optionalPeerDependencies",
    "unlisted",
    "binaries",
    "unresolved",
    "exports",
    "nsExports",
    "types",
    "nsTypes",
    "enumMembers",
    "namespaceMembers",
    "duplicates",
    "catalog",
    "catalogReferences",
    "cycles",
  ],
  // The default for `cycles` is `warn` (which never fails the command).
  // Promoting it to `error` makes `pnpm knip` a real CI gate for cycles,
  // replacing `madge --circular`.
  "rules": {
    "cycles": "error",
  },
    "workspaces": {
    "apps/web": {
      "entry": ["index.html"],
      "project": ["src/**/*.{ts,tsx}"],
    },
  },
}
